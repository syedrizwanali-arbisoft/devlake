@page "/Clients/{id:long}/Secrets/{secretId:long}/Revoke"
@model Arbisoft.DevLake.IntegrationService.Web.Pages.Clients.Secrets.RevokeModel
@{
    ViewData["Title"] = "Revoke secret";
}
<h1>Revoke secret @Model.SecretId</h1>
<form method="post" class="panel">
  <p>The client can no longer get new tokens with this secret. Tokens it already has keep working until they expire; revoke those on the Access tokens page if needed.</p>
  <div class="actions"><button class="danger" type="submit">Revoke secret</button><a asp-page="/Clients/Details" asp-route-id="@Model.Id">Cancel</a></div>
</form>
