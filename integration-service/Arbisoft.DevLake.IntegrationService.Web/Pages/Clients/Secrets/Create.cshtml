@page "/Clients/{id:long}/Secrets/Create"
@model Arbisoft.DevLake.IntegrationService.Web.Pages.Clients.Secrets.CreateModel
@{
    ViewData["Title"] = "New secret";
}
<h1>New secret</h1>
@if (Model.Created is { } created)
{
    <div class="secret" role="alert">
      <p><strong>Copy this secret now. It won't be shown again</strong>; only a hash is stored.</p>
      <dl>
        <dt>Client ID</dt><dd class="mono">@created.ClientId</dd>
        <dt>Client secret</dt><dd class="mono long">@created.Secret</dd>
        <dt>Expires</dt><dd>@AdminPageModel.Utc(created.ExpiresOn)</dd>
      </dl>
      <p class="muted">Share both values with the client through Passbolt.</p>
    </div>
    <a class="button" asp-page="/Clients/Details" asp-route-id="@Model.Id">Done</a>
}
else
{
    <form method="post" class="stack panel">
      <label>Valid for (days) <input type="number" asp-for="ValidForDays" min="1" max="730" required></label>
      <div class="actions"><button type="submit">Create secret</button><a asp-page="/Clients/Details" asp-route-id="@Model.Id">Cancel</a></div>
    </form>
}
