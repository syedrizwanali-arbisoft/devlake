@model Arbisoft.DevLake.IntegrationService.Web.Pages.Clients.ClientForm
<label>Name <input type="text" name="Form.Name" value="@Model.Name" maxlength="200" required></label>
<label>Access token lifetime (seconds)
  <input type="number" name="Form.AccessTokenLifetimeSeconds" value="@Model.AccessTokenLifetimeSeconds" min="60" max="86400" required>
</label>
<label class="check"><input type="checkbox" name="Form.IsActive" value="true" @(Model.IsActive ? "checked" : "")> Active (can get tokens)</label>
@* An unticked checkbox sends nothing, so this hidden value makes "unticked" arrive as false. The first value wins. *@
<input type="hidden" name="Form.IsActive" value="false">
