@page "{id:long}"
@model Arbisoft.DevLake.IntegrationService.Web.Pages.Clients.DetailsModel
@{
    var c = Model.Details!.Client;
    ViewData["Title"] = c.Name;
}
<h1>@c.Name</h1>
<div class="actions">
  <a class="button secondary" asp-page="Edit" asp-route-id="@c.Id">Edit</a>
  <a class="button" asp-page="Secrets/Create" asp-route-id="@c.Id">New secret</a>
</div>
<div class="panel">
  <dl>
    <dt>Client ID</dt><dd class="mono">@c.ClientId</dd>
    <dt>Status</dt><dd><span class="badge @(c.IsActive ? "Active" : "Inactive")">@(c.IsActive ? "Active" : "Inactive")</span></dd>
    <dt>Token lifetime</dt><dd>@c.AccessTokenLifetimeSeconds seconds</dd>
    <dt>Created</dt><dd>@AdminPageModel.Utc(c.CreatedOn) by @c.CreatedBy</dd>
    <dt>Modified</dt><dd>@(c.ModifiedOn is null ? "—" : $"{AdminPageModel.Utc(c.ModifiedOn)} by {c.ModifiedBy}")</dd>
  </dl>
</div>

<h2>Outbound config</h2>
<div class="panel">
  @if (Model.Config is { } config)
  {
      <dl>
        <dt>Auth</dt><dd>@AdminLabels.AuthType(config.AuthType)</dd>
        <dt>Base URL</dt><dd class="mono">@config.BaseUrl</dd>
        <dt>Status</dt><dd><span class="badge @(config.IsActive ? "Active" : "Inactive")">@(config.IsActive ? "Active" : "Inactive")</span></dd>
        <dt>Callbacks</dt><dd>@Model.OutboundUrlCount configured</dd>
      </dl>
  }
  else
  {
      <p class="muted">No outbound config. Results can't be delivered to this client, so its stats requests are revoked.</p>
  }
  <div class="actions">
    <a class="button secondary" asp-page="/ClientConfigs/Edit" asp-route-clientId="@c.Id">@(Model.Config is null ? "Set up" : "Edit") outbound config</a>
    @if (Model.Config is not null) { <a class="button secondary" asp-page="/ClientConfigs/OutboundUrls/Index" asp-route-clientId="@c.Id">Callback URLs</a> }
  </div>
</div>

<h2>Scopes</h2>
<form method="post" asp-page-handler="Scopes" class="panel">
  @if (Model.Details.AllScopes.Count == 0)
  {
      <p class="muted">No scopes exist yet. <a asp-page="/Scopes/Create">Create one</a>.</p>
  }
  @foreach (var scope in Model.Details.AllScopes)
  {
      <label class="check">
        <input type="checkbox" name="ScopeIds" value="@scope.Id" @(Model.Details.AssignedScopes.Any(s => s.Id == scope.Id) ? "checked" : "")>
        <span class="mono">@scope.Name</span> <span class="muted">@scope.Description</span>
      </label>
  }
  <div class="actions"><button type="submit">Save scopes</button><span class="muted">New tokens carry the saved scopes.</span></div>
</form>

<h2>Secrets</h2>
<p class="muted">A client can hold more than one secret, so a new one can be shared through Passbolt before the old one is revoked.</p>
<div class="table-wrap">
<table>
  <thead><tr><th>ID</th><th>Status</th><th>Expires</th><th>Last used</th><th>Created</th><th></th></tr></thead>
  <tbody>
  @foreach (var secret in Model.Details.Secrets)
  {
      <tr>
        <td>@secret.Id</td>
        <td><span class="badge @secret.Status">@secret.Status</span></td>
        <td>@AdminPageModel.Utc(secret.ExpiresOn)</td>
        <td>@AdminPageModel.Utc(secret.LastUsedOn)</td>
        <td>@AdminPageModel.Utc(secret.CreatedOn) <span class="muted">by @secret.CreatedBy</span></td>
        <td>@if (secret.RevokedOn is null) { <a asp-page="Secrets/Revoke" asp-route-id="@c.Id" asp-route-secretId="@secret.Id">Revoke</a> }
            else { <span class="muted">Revoked @AdminPageModel.Utc(secret.RevokedOn)</span> }</td>
      </tr>
  }
  @if (Model.Details.Secrets.Count == 0)
  {
      <tr><td colspan="6" class="muted">No secrets yet. The client can't get tokens until it has one.</td></tr>
  }
  </tbody>
</table>
</div>
