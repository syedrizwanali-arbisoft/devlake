@page
@model Arbisoft.DevLake.IntegrationService.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
@if (!Model.IsConfigured)
{
    <div class="errors">Admin sign-in is not configured. Set Admin__Username and Admin__PasswordHash.</div>
}
<form method="post" class="stack panel">
  <input type="hidden" asp-for="ReturnUrl">
  <label>Username <input type="text" asp-for="Username" autocomplete="username" required></label>
  <label>Password <input type="password" asp-for="Password" autocomplete="current-password" required></label>
  <div><button type="submit">Sign in</button></div>
</form>
