@page
@model Arbisoft.DevLake.IntegrationService.Web.Pages.SigningKeys.RotateModel
@{
    ViewData["Title"] = "Rotate signing key";
}
<h1>Rotate signing key</h1>
<form method="post" class="panel">
  <p>This creates a new RSA key, stores its private key encrypted in the database, and makes it the active key. The current key is retired: it no longer signs new tokens, but the tokens it signed keep working until they expire.</p>
  <div class="actions"><button type="submit">Rotate now</button><a asp-page="Index">Cancel</a></div>
</form>
