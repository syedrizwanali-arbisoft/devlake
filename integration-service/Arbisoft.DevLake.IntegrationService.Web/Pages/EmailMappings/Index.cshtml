@page
@model Arbisoft.DevLake.IntegrationService.Web.Pages.EmailMappings.IndexModel
@{
    ViewData["Title"] = "Email mappings";
}
<h1>Email mappings</h1>
<p class="muted">The other emails an engineer commits with. Stats for an Arbisoft email also count work done under its mapped emails.</p>
<form method="get" class="actions">
  <input type="search" name="Search" value="@Model.Search" placeholder="Search either email" maxlength="255">
  <button type="submit">Search</button>
  <a class="button" asp-page="Create">New mapping</a>
</form>
<div class="table-wrap">
<table>
  <thead><tr><th>Arbisoft email</th><th>Mapped email</th><th>As typed</th><th>Created</th><th></th></tr></thead>
  <tbody>
  @foreach (var mapping in Model.Result.Items)
  {
      <tr>
        <td class="mono">@mapping.ArbisoftEmail</td>
        <td class="mono">@mapping.Email</td>
        <td class="mono muted">@mapping.EmailAsReceived</td>
        <td>@AdminPageModel.Utc(mapping.CreatedOn)</td>
        <td><a asp-page="Edit" asp-route-id="@mapping.Id">Edit</a></td>
      </tr>
  }
  @if (Model.Result.Items.Count == 0)
  {
      <tr><td colspan="5" class="muted">No mappings found.</td></tr>
  }
  </tbody>
</table>
</div>
<p class="muted">
  @Model.Result.TotalCount mappings. Page @Model.Result.Page of @Model.Result.TotalPages.
  @if (Model.Result.HasPrevious) { <a asp-page="Index" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.Result.Page - 1)">Previous</a> }
  @if (Model.Result.HasNext) { <a asp-page="Index" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.Result.Page + 1)">Next</a> }
</p>
