@model Arbisoft.DevLake.IntegrationService.Web.Pages.EmailMappings.MappingForm
<label>Arbisoft email <input type="email" name="Form.ArbisoftEmail" value="@Model.ArbisoftEmail" maxlength="255" required></label>
<label>Mapped email <input type="email" name="Form.Email" value="@Model.Email" maxlength="255" required></label>
<p class="muted">Both are trimmed and lower-cased before they are saved. The mapped email is also kept as you typed it.</p>
