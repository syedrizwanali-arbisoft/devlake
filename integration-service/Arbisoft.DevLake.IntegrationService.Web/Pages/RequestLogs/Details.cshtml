@page "{id:long}"
@model Arbisoft.DevLake.IntegrationService.Web.Pages.RequestLogs.DetailsModel
@{
    ViewData["Title"] = "Request " + Model.Log.CorrelationId;
    var log = Model.Log;
}
<h1>Request <span class="mono">@log.CorrelationId</span></h1>
<div class="panel">
  <dl>
    <dt>Client</dt><dd>@log.ClientName <span class="mono muted">@log.ClientId</span></dd>
    <dt>Event type</dt><dd class="mono">@log.EventType</dd>
    <dt>Status</dt><dd>@log.Status</dd>
    <dt>Created</dt><dd>@AdminPageModel.Utc(log.CreatedOn)</dd>
    <dt>Request</dt><dd class="mono long">@log.Url</dd>
  </dl>
</div>
<h2>Body</h2>
<p class="muted">As the client sent it. It holds engineer emails, so treat it as personal data.</p>
@if (string.IsNullOrEmpty(log.Json))
{
    <p class="muted">No body was stored.</p>
}
else
{
    <pre class="panel mono">@log.Json</pre>
}
<h2>Delivery attempts</h2>
<div class="table-wrap">
<table>
  <thead><tr><th>When</th><th>Outcome</th><th>By</th><th>Error</th></tr></thead>
  <tbody>
  @foreach (var attempt in log.Attempts)
  {
      <tr>
        <td>@AdminPageModel.Utc(attempt.AttemptOn)</td>
        <td>@attempt.AttemptStatus</td>
        <td>@attempt.AttemptBy</td>
        <td>@(attempt.FailureError ?? "")</td>
      </tr>
      @if (!string.IsNullOrEmpty(attempt.ResponseJson))
      {
          <tr><td colspan="4"><details><summary>The client's response</summary><pre class="mono">@attempt.ResponseJson</pre></details></td></tr>
      }
  }
  @if (log.Attempts.Count == 0)
  {
      <tr><td colspan="4" class="muted">Not delivered yet.</td></tr>
  }
  </tbody>
</table>
</div>
<p><a asp-page="Index">Back to the list</a></p>
