@using Arbisoft.DevLake.IntegrationService.Business.Services.Admin
@model Arbisoft.DevLake.IntegrationService.Web.Pages.ClientConfigs.Urls.UrlForm
<label>Event type
  <select name="Form.EventType">
    @foreach (var type in ClientConfigService.KnownEventTypes)
    {
        <option value="@type" selected="@(type == Model.EventType)">@type</option>
    }
  </select>
</label>
<label>Method
  <select name="Form.Method">
    @foreach (var method in ClientConfigService.KnownMethods)
    {
        <option value="@method" selected="@(method == Model.Method)">@method</option>
    }
  </select>
</label>
<label>Path <input type="text" name="Form.Path" value="@Model.Path" maxlength="500" required placeholder="/api/v1/devlake/callback/"></label>
<p class="muted">Starts with a single "/" and is added to the base URL. It cannot point at another host.</p>
<label class="check"><input type="checkbox" name="Form.IsActive" value="true" @(Model.IsActive ? "checked" : "")> Active</label>
<input type="hidden" name="Form.IsActive" value="false">
