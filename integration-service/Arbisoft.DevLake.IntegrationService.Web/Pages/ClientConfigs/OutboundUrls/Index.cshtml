@page "/ClientConfigs/{clientId:long}/OutboundUrls"
@model Arbisoft.DevLake.IntegrationService.Web.Pages.ClientConfigs.OutboundUrls.IndexModel
@{
    ViewData["Title"] = "Callback URLs";
}
<h1>Callback URLs for @Model.ClientName</h1>
<p class="muted">Each event type is delivered to its active URL, relative to <span class="mono">@Model.BaseUrl</span>.
  Stats requests use <span class="mono">engineer-stats</span> and <span class="mono">engineer-stats-batch</span>; a request without an active URL is revoked.</p>
<div class="actions">
  <a class="button" asp-page="Create" asp-route-clientId="@Model.ClientId">New callback URL</a>
  <a asp-page="/Clients/Details" asp-route-id="@Model.ClientId">Back to client</a>
</div>
<div class="table-wrap">
<table>
  <thead><tr><th>Event type</th><th>Method</th><th>Path</th><th>Status</th><th>Changed</th><th></th></tr></thead>
  <tbody>
  @foreach (var url in Model.Urls)
  {
      <tr><td class="mono">@url.EventType</td><td>@url.Method</td><td class="mono">@url.Path</td>
          <td><span class="badge @(url.IsActive ? "Active" : "Inactive")">@(url.IsActive ? "Active" : "Inactive")</span></td>
          <td>@AdminPageModel.Utc(url.ModifiedOn ?? url.CreatedOn) <span class="muted">by @(url.ModifiedBy ?? url.CreatedBy)</span></td>
          <td><a asp-page="Edit" asp-route-clientId="@Model.ClientId" asp-route-urlId="@url.Id">Edit</a></td></tr>
  }
  @if (Model.Urls.Count == 0)
  {
      <tr><td colspan="6" class="muted">No callback URLs yet.</td></tr>
  }
  </tbody>
</table>
</div>
