@model Arbisoft.DevLake.IntegrationService.Web.Pages.ClientConfigs.OutboundUrls.UrlForm
<label>Event type <input type="text" name="Form.EventType" value="@Model.EventType" list="event-types" maxlength="128" required></label>
<datalist id="event-types">
  @foreach (var type in Arbisoft.DevLake.IntegrationService.Web.Pages.ClientConfigs.OutboundUrls.UrlForm.KnownEventTypes) { <option value="@type"></option> }
</datalist>
<label>Method
  <select name="Form.Method">
    @foreach (var method in Arbisoft.DevLake.IntegrationService.Business.Services.Admin.ClientConfigService.Methods) { <option value="@method" selected="@(method == Model.Method)">@method</option> }
  </select>
</label>
<label>Path <input type="text" name="Form.Path" value="@Model.Path" placeholder="/api/v1/devlake/callback/" maxlength="2048" required></label>
<label class="check"><input type="checkbox" name="Form.IsActive" value="true" @(Model.IsActive ? "checked" : "")> Active</label>
<input type="hidden" name="Form.IsActive" value="false">
