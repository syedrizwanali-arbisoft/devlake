@page
@{
    ViewData["Title"] = "Home";
}
<h1>Integration Service Admin</h1>
<div class="panel">
  <p>Manage who can call the Integration Service and how their tokens are signed.</p>
  <ul>
    <li><a asp-page="/Clients/Index">Clients</a>: registered systems, their secrets and scopes.</li>
    <li><a asp-page="/Scopes/Index">Scopes</a>: permissions a token can carry.</li>
    <li><a asp-page="/SigningKeys/Index">Signing keys</a>: the keys that sign tokens, and rotation.</li>
    <li><a asp-page="/AccessTokens/Index">Access tokens</a>: issued tokens, and revocation.</li>
    <li><a asp-page="/EmailMappings/Index">Email mappings</a>: the other emails each engineer commits with.</li>
    <li><a asp-page="/RequestLogs/Index">Request logs</a>: stats requests, their status, body and delivery attempts.</li>
  </ul>
</div>
