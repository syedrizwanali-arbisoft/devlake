@page "{jti}"
@model Arbisoft.DevLake.IntegrationService.Web.Pages.AccessTokens.RevokeModel
@{
    ViewData["Title"] = "Revoke token";
}
<h1>Revoke token</h1>
@if (Model.Token is { } token)
{
    <div class="panel">
      <dl>
        <dt>Client</dt><dd>@token.ClientName <span class="mono muted">@token.ClientId</span></dd>
        <dt>Token ID</dt><dd class="mono long">@token.Jti</dd>
        <dt>Scopes</dt><dd class="mono">@token.GrantedScopes</dd>
        <dt>Expires</dt><dd>@AdminPageModel.Utc(token.ExpiresOn)</dd>
      </dl>
    </div>
}
<form method="post" class="stack panel" style="margin-top:16px">
  <label>Reason <input type="text" asp-for="Reason" maxlength="900" required></label>
  <p class="muted">The API rejects the token on its next use. The client can still get a new token while it has a valid secret.</p>
  <div class="actions"><button class="danger" type="submit">Revoke token</button><a asp-page="Index">Cancel</a></div>
</form>
