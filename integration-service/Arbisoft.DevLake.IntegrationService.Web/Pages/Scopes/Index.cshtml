@page
@model Arbisoft.DevLake.IntegrationService.Web.Pages.Scopes.IndexModel
@{
    ViewData["Title"] = "Scopes";
}
<h1>Scopes</h1>
<p class="muted">The APIs check these names: <span class="mono">stats:read</span> for the stats and poll APIs, <span class="mono">projects:fetch</span> for Workstream projects.</p>
<div class="actions"><a class="button" asp-page="Create">New scope</a></div>
<div class="table-wrap">
<table>
  <thead><tr><th>Name</th><th>Description</th><th>Created</th><th></th></tr></thead>
  <tbody>
  @foreach (var scope in Model.Scopes)
  {
      <tr><td class="mono">@scope.Name</td><td>@scope.Description</td><td>@AdminPageModel.Utc(scope.CreatedOn)</td>
          <td><a asp-page="Edit" asp-route-id="@scope.Id">Edit</a></td></tr>
  }
  @if (Model.Scopes.Count == 0)
  {
      <tr><td colspan="4" class="muted">No scopes yet.</td></tr>
  }
  </tbody>
</table>
</div>
