{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "RunMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "arbisoft-devlake-integration-service",
    "Audience": "arbisoft-devlake-integration-api"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "RequestQueue": "integration.stats.requests"
  },
  "Requests": {
    "DuplicateWindowSeconds": 300,
    "AllowedEmailDomain": "arbisoft.com",
    "MaxBatchEmails": 20
  },
  "Processing": {
    "Enabled": false,
    "IntervalSeconds": 60,
    "MaxMessagesPerRun": 100,
    "MaxParallelDevLakeCalls": 16,
    "DeliveryRetryDelaySeconds": 5
  },
  "DevLake": {
    "BaseUrl": "http://localhost:8080/rest/",
    "TimeoutSeconds": 30
  },
  "Sophia": {
    "TimeoutSeconds": 30,
    "TokenRenewalMarginSeconds": 60
  },
  "Workstream": {
    "BaseUrl": "",
    "PageSize": 10,
    "TimeoutSeconds": 30
  }
}
