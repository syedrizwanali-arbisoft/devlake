{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "RunMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "UseTls": false,
    "ConnectionName": "integration-service",
    "RequestQueueName": "integration.stats-requests",
    "QueueMaxLength": 10000,
    "MessageTtlSeconds": 7200,
    "DeliveryLimit": 5,
    "ReceiveBatchLimit": 10
  },
  "DevLake": {
    "BaseUrl": "http://localhost:8080",
    "ApiToken": "",
    "TimeoutSeconds": 30
  },
  "Security": {
    "EncryptionKey": "",
    "Issuer": "https://integration-service",
    "Audience": "integration-service"
  },
  "Sophia": {
    "TimeoutSeconds": 30
  },
  "Workstream": {
    "BaseUrl": "http://localhost:5097",
    "ApiToken": "",
    "PageSize": 10,
    "TimeoutSeconds": 30
  }
}
