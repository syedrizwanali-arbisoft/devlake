{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "arbisoft-devlake-integration-service",
    "Audience": "arbisoft-devlake-integration-api"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "RequestQueue": "integration.stats.requests"
  },
  "DevLake": {
    "BaseUrl": "http://localhost:8080"
  },
  "Workstream": {
    "BaseUrl": ""
  }
}
