{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "arbisoft-devlake-integration-service",
    "Audience": "arbisoft-devlake-integration-api"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "RequestQueue": "integration.stats.requests"
  },
  "RateLimits": {
    "StatsPerMinute": 100,
    "BatchStatsPerMinute": 20,
    "PollPerMinute": 100
  },
  "Requests": {
    "DuplicateWindowSeconds": 300,
    "AllowedEmailDomain": "arbisoft.com",
    "MaxBatchEmails": 20
  },
  "DevLake": {
    "BaseUrl": "http://localhost:8080",
    "TimeoutSeconds": 30
  },
  "Sophia": {
    "TimeoutSeconds": 30,
    "TokenRenewalMarginSeconds": 60
  },
  "Workstream": {
    "BaseUrl": "",
    "PageSize": 10,
    "TimeoutSeconds": 30
  }
}
