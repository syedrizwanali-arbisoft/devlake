{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "RunMigrationsOnStartup": true,
    "CommandTimeoutSeconds": 30
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "UseTls": false,
    "ConnectionName": "integration-service",
    "RequestQueueName": "integration.stats-requests",
    "QueueMaxLength": 10000,
    "MessageTtlSeconds": 7200,
    "DeliveryLimit": 5,
    "ReceiveBatchLimit": 10
  },
  "DevLake": {
    "BaseUrl": "http://localhost:8080/rest/",
    "ApiToken": "",
    "TimeoutSeconds": 30,
    "MaxConcurrentRequests": 8
  },
  "Resilience": {
    "MaxRetries": 3,
    "RetryBaseDelayMilliseconds": 1000,
    "BreakerFailureRatio": 0.5,
    "BreakerMinimumThroughput": 10,
    "BreakerSamplingSeconds": 30,
    "BreakerBreakSeconds": 30
  },
  "Security": {
    "EncryptionKey": "",
    "Issuer": "https://integration-service",
    "Audience": "integration-service"
  },
  "Processing": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "MaxParallelRequests": 4,
    "DeliveryRetryDelaySeconds": 30,
    "StaleGraceSeconds": 60
  },
  "RateLimits": {
    "StatsPerMinute": 100,
    "BatchPerMinute": 20,
    "PollPerMinute": 100
  },
  "Requests": {
    "DuplicateWindowMinutes": 15,
    "AllowedEmailDomains": [ "arbisoft.com" ]
  },
  "Sophia": {
    "TimeoutSeconds": 30
  },
  "Workstream": {
    "BaseUrl": "http://localhost:5097",
    "ApiToken": "",
    "PageSize": 10,
    "TimeoutSeconds": 30
  }
}
